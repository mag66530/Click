@echo off
chcp 65001 >nul
title Click - публикация с видимым окном браузера

REM ═══════════════════════════════════════════════════════════════
REM  То же самое, что START.bat, но браузер работает НЕ скрыто:
REM  на экране видно, как Click открывает карточку, вводит текст и
REM  жмёт «Создать». Удобно, когда надо понять, где что не так.
REM
REM  Обычный запуск (браузер скрыт) - START.bat
REM ═══════════════════════════════════════════════════════════════

cd /d "%~dp0"
set CLICK_HEADED=1

echo.
echo  Запускаю Click в режиме «видно браузер».
echo  Окно Firefox/Chrome откроется само, когда начнётся публикация.
echo.

call START.bat
